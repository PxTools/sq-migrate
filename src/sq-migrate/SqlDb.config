<?xml version="1.0" encoding="iso-8859-1"?>
<SqlDbConfig version="2008" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="SqlDbConfig.xsd">
	<Database id="ssd" metaModel="2.4">
		<Descriptions>
			<Description lang="sv">Statistikdatabasen </Description>
			<Description lang="en">Statistical database </Description>
		</Descriptions>
		<Connection databaseType="MSSQLSERVER" dataProvider="Sql" useTemporaryTables="true" >
			<ConnectionString>Data Source=ssdyttre.test.sql;Initial Catalog=SDB_MetabasVy23;Integrated Security=True; enlist=false; </ConnectionString>
			<DefaultUser>xx</DefaultUser>
			<DefaultPassword>xx</DefaultPassword>
		</Connection>
		<Languages>
			<Language main="true" name="Swedish" code="sv" metaSuffix="" />
			<Language main="false" name="English" code="en" metaSuffix="ENG" />
		</Languages>
		<Codes />

		<Keywords>

		</Keywords>
		<Tables>
			<Table modelName="Contents" tableName="Contents" alias="CNT">
				<Columns>

					<Column modelName="LastUpdated" columnName="Published"/>

				</Columns>
			</Table>
		</Tables>
	</Database>

</SqlDbConfig>